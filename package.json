{
  "name": "pipt-world",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive field notebook for a small creature learning one question at a time.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piptWorld/pipt.git"
  },
  "homepage": "https://github.com/piptWorld/pipt#readme",
  "bugs": {
    "url": "https://github.com/piptWorld/pipt/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "notebook:check": "node scripts/record-next-lesson.mjs --check",
    "notebook:next": "node scripts/record-next-lesson.mjs",
    "check": "npm run notebook:check && npm run lint && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
